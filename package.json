{
  "name": "balanza_web",
  "version": "0.1.3",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "electron": "concurrently \"npm run dev\" \"npm run electron:start\"",
    "electron:start": "wait-on http://localhost:5173 && electron electron/main.js",
    "build:web": "vite build",
    "build:electron": "electron-builder",
    "start": "NODE_ENV=production electron electron/main.js"
  },
  "build": {
    "appId": "com.tesis.balanza",
    "productName": "Balanza Asistencia",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@primevue/forms": "^4.2.5",
    "@primevue/themes": "^4.2.5",
    "@tailwindcss/vite": "^4.0.4",
    "@vueuse/components": "^13.0.0",
    "@vueuse/core": "^13.0.0",
    "axios": "^1.7.9",
    "file-saver": "^2.0.5",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^2.3.1",
    "primeflex": "^3.3.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.3",
    "quill": "^2.0.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@primevue/auto-import-resolver": "^4.2.5",
    "@tsconfig/node22": "^22.0.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.13.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12",
    "npm-run-all2": "^7.0.2",
    "pkg": "^5.8.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.4",
    "typescript": "~5.7.3",
    "unplugin-vue-components": "^28.0.0",
    "vite": "^6.3.5",
    "vite-plugin-vue-devtools": "^7.7.1",
    "vue-tsc": "^2.2.0",
    "wait-on": "^7.2.0"
  }, "pkg": {
  "targets": [
    "node18-win-x64"
  ],
  "outputPath": "launcher-dist",
  "scripts": [
    "launcher.js"
  ]
}


}
